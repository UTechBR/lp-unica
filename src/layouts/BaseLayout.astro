---
import { Header } from "../components/Header.tsx";
import { Footer } from "../components/Footer.tsx";
import { AnecPopup } from "../components/AnecPopup.tsx";
import { CookieConsent } from "../components/CookieConsent.tsx";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const fullTitle = `Única Promotora | ${title}`;
const siteUrl = "https://unicapromotora.com.br";
const canonicalUrl = `${siteUrl}${currentPath}`;
// Crawlers de Open Graph/Twitter não resolvem caminhos relativos.
const ogImageUrl = `${siteUrl}/og-image.jpg`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#D5040C" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="crédito consignado, FGTS, promotora de crédito, empréstimo, cartão consignado, seguro prestamista, Única Promotora"
    />
    <meta name="author" content="Única Promotora" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Única Promotora" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Única Promotora" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FinancialService",
        "name": "Única Promotora",
        "url": "https://unicapromotora.com.br/",
        "logo": "https://unicapromotora.com.br/favicon.png",
        "image": "https://unicapromotora.com.br/og-image.jpg",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "R. Rio de Janeiro, 600, Sala 401 a 408 - Centro",
          "addressLocality": "Belo Horizonte",
          "addressRegion": "MG",
          "postalCode": "30160-041",
          "addressCountry": "BR"
        },
        "telephone": "+55-31-2116-5020",
        "email": "contato@unicapromotora.com.br"
      }
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <!-- Sem ScrollToTop: numa MPA real, cada navegação já é um carregamento novo de
           página, então o navegador cuida disso nativamente (inclusive rolagem de
           âncora com scroll-margin, sem hook nenhum). -->
      <Header currentPath={currentPath} client:load />
      <AnecPopup client:idle />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer />
      <!-- client:load: o banner de consentimento deve aparecer logo, e o link
           "Preferências de cookies" do rodapé depende dele já hidratado. -->
      <CookieConsent client:load />
    </div>
    <script src="https://unpkg.com/blip-chat-widget" type="text/javascript"
    ></script>
    <style>
      @keyframes cookie-consent-pulse {
        0% {
          box-shadow: 0 0 0 0 rgba(213, 4, 12, 0.9);
        }
        100% {
          box-shadow: 0 0 0 20px rgba(255, 77, 74, 0);
        }
      }

      @keyframes chat-pulse-on-dark {
        0% {
          box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.6);
        }
        100% {
          box-shadow: 0 0 0 16px rgba(255, 255, 255, 0);
        }
      }

      :global(#blip-chat-open-iframe:not(.opened)) {
        animation: cookie-consent-pulse 2s infinite;
      }

      /* Drawer, modais e popups abertos (ver useLockBodyScroll): o botão do chat
         não pode ficar por cima deles. Com o chat já aberto, ele permanece.
         !important: o widget da Blip define display inline. */
      :global(html.overlay-open #blip-chat-open-iframe:not(.opened)) {
        display: none !important;
      }

      /* Sobre fundos escuros ou vermelhos o anel vermelho some ou pesa demais;
         usa um pulso claro e discreto. */
      :global(html.chat-on-dark #blip-chat-open-iframe:not(.opened)) {
        animation-name: chat-pulse-on-dark;
      }

      @media (prefers-reduced-motion: reduce) {
        :global(#blip-chat-open-iframe:not(.opened)) {
          animation: none;
          box-shadow: 0 0 0 5px rgba(213, 4, 12, 0.55);
        }

        :global(html.chat-on-dark #blip-chat-open-iframe:not(.opened)) {
          animation: none;
          box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.45);
        }
      }
    </style>
    <script>
      (function () {
        window.addEventListener("load", function () {
          const blipChat = new BlipChat()
            .withAppKey(
              "dW5pY2FwYXJjZWlybzFwcmQ6NjAxNDJkOWQtMGM2OS00NzA3LTgzNjUtZmMzZGFlY2FlMjM1",
            )
            .withButton({
              color: "#e50e0a",
              icon: "https://blipmediastore.blob.core.windows.net/permanent/Media_4_59b1da4c-a9f3-4f9b-a9d5-7d1e8cd4b739",
            })
            .withCustomCommonUrl("https://unicapromotora.chat.blip.ai/");
          blipChat.build();
          watchChatBackground();
        });

        // Marca <html> com .chat-on-dark quando o botão do chat está sobre uma
        // superfície escura, para trocar o pulso vermelho por um claro.
        function isDarkSurface(el: Element) {
          for (let node: Element | null = el; node && node !== document.documentElement; node = node.parentElement) {
            const style = getComputedStyle(node);
            if (style.backgroundImage !== "none" && node.tagName !== "IMG") return true;
            const match = style.backgroundColor.match(/\d+(\.\d+)?/g);
            if (!match) continue;
            const [r, g, b, a = 1] = match.map(Number);
            if (a === 0) continue;
            return 0.2126 * r + 0.7152 * g + 0.0722 * b < 140;
          }
          return false;
        }

        function watchChatBackground() {
          let frame = 0;
          const update = () => {
            frame = 0;
            const button = document.getElementById("blip-chat-open-iframe");
            if (!button) return;
            const rect = button.getBoundingClientRect();
            const behind = document
              .elementsFromPoint(rect.left + rect.width / 2, rect.top + rect.height / 2)
              .find((el) => el.tagName !== "IFRAME" && !el.closest("#blip-chat-container"));
            document.documentElement.classList.toggle("chat-on-dark", !!behind && isDarkSurface(behind));
          };
          const schedule = () => {
            if (!frame) frame = requestAnimationFrame(update);
          };
          window.addEventListener("scroll", schedule, { passive: true });
          window.addEventListener("resize", schedule);
          // O botão é inserido de forma assíncrona pelo widget.
          setTimeout(schedule, 500);
          setTimeout(schedule, 2000);
        }
      })();
    </script>
  </body>
</html>
