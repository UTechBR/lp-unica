---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ProdutosHero } from '../components/ProdutosHero.tsx';
import { ProdutosContent } from '../components/ProdutosContent.tsx';
import { listar } from '../lib/conteudo';

const produtos = await listar('produtos');
---

<BaseLayout
  title="Nossos Produtos"
  description="Conheça todas as soluções financeiras da Única Promotora: consignado, crédito pessoal, FGTS, cartões, seguro prestamista e mais."
>
  <ProdutosHero />
  <!-- Hidratada: cada bloco de produto tem fade-in próprio ao entrar na viewport
       (7 gatilhos independentes, não um stagger único). -->
  <ProdutosContent client:visible produtos={produtos} />
</BaseLayout>
