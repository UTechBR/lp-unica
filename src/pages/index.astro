---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Hero } from '../components/Hero.tsx';
import SobreSection from '../components/SobreSection.astro';
import Shorts from '../components/Shorts.astro';
import { Ecossistema } from '../components/Ecossistema.tsx';
import { ProductsSection } from '../components/ProductsSection.tsx';
import { FinalCta } from '../components/FinalCta.tsx';
import { listar } from '../lib/conteudo';

const [bancos, categorias, ferramentas] = await Promise.all([
  listar('bancos'),
  listar('categorias-produto'),
  listar('ecossistema'),
]);
---

<BaseLayout
  title="A solução mais eficaz para você"
  description="Utilizamos nossa experiência e conhecimento diariamente para oferecer a solução mais eficaz para você."
>
  <!-- Ordem segue a jornada de quem avalia a parceria: primeiro o valor (bancos no
       hero, produtos, sistemas), depois a confiança (sobre, shorts) e o fechamento. -->

  <!-- Hidratada logo (client:load): é o formulário de lead, o objetivo comercial
       principal do site — precisa estar interativo assim que a página carrega,
       sem esperar entrar na viewport (já está visível de cara). -->
  <Hero client:load bancos={bancos} />
  <!-- Sem JS a grade de bancos não é embaralhada; mostra na ordem do arquivo. -->
  <noscript><style>.bancos-hero-grid { opacity: 1 !important; }</style></noscript>

  <!-- Sem client:*: grid de cards 100% estático, sem nenhuma interação/animação
       no componente original. -->
  <ProductsSection categorias={categorias} />

  <!-- Sem client:*: cards estáticos, sem animação de entrada. -->
  <Ecossistema ferramentas={ferramentas} />

  <!-- Sem client:*: zero JavaScript. Versão condensada; /sobre usa MissionVisionValues. -->
  <SobreSection />

  <!-- Sem React: <dialog> nativo + script pequeno. Cards sem vídeo abrem o Instagram. -->
  <Shorts />

  <!-- Sem client:*: só uma âncora de volta ao formulário. -->
  <FinalCta />
</BaseLayout>
