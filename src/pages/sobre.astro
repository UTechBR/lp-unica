---
import BaseLayout from '../layouts/BaseLayout.astro';
import SobreSection from '../components/SobreSection.astro';
import { FinalCta } from '../components/FinalCta.tsx';

// Montada com os mesmos componentes da Home: atualizar a seção Sobre atualiza os dois.
// A própria seção abre a página (h1 + eyebrow), em vez de um PageHeader: dois blocos
// grafite seguidos se leriam como um só. Conteúdo exclusivo (linha do tempo, liderança,
// números comprovados) entra entre a seção e o CTA, quando existir.
---

<BaseLayout
  title="Sobre a Única Promotora"
  description="Conheça a Única Promotora, correspondente bancário em Belo Horizonte: quem somos, como trabalhamos e os valores que guiam o trabalho com nossos correspondentes."
>
  <SobreSection cabecalho={{ eyebrow: 'Nossa história' }} />
  <FinalCta />
</BaseLayout>
