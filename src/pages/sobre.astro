---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SobreHero } from '../components/SobreHero.tsx';
import MissionVisionValues from '../components/MissionVisionValues.astro';
import { CtaSection } from '../components/CtaSection.tsx';
---

<BaseLayout
  title="Sobre Nós"
  description="Conheça a história, missão e valores da Única Promotora, correspondente bancário especializado em crédito e soluções financeiras."
>
  <!-- Hidratada: tem fade-in de entrada (Framer Motion). client:visible porque não
       precisa estar interativa antes de entrar na tela. -->
  <SobreHero client:visible />

  <!-- Sem client:*: zero JavaScript enviado ao navegador pra esta seção. É puro
       HTML/CSS — o componente React de origem não tem nenhuma interatividade,
       então o Astro renderiza ele em build time e não hidrata nada. -->
  <MissionVisionValues />

  <!-- Hidratada: mesma razão do hero, fade-in ao entrar na viewport. -->
  <CtaSection client:visible />
</BaseLayout>
