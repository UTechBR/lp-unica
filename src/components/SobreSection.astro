---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { homePositioning } from '../config/empresa';
import { icones } from '../lib/icones';
import fotoBruno from '../assets/pessoas/bruno-iacomini.png';

// Seção Sobre (Home e /sobre). Uma imagem só para os dois layouts: no mobile é um
// bloco 4:3 acima do texto; a partir de lg vira fundo da seção.
const valores = await getCollection('valores');
---

<span id="sobre-nos" class="block scroll-mt-20" aria-hidden="true"></span>
<section id="sobre" class="relative scroll-mt-20 overflow-hidden bg-surface-dark text-white">
  <figure class="relative aspect-[4/3] w-full lg:absolute lg:inset-0 lg:aspect-auto">
    <Image
      src={fotoBruno}
      alt="Bruno Iacomini, CEO da Única Promotora"
      widths={[640, 1024, 1920]}
      sizes="100vw"
      class="h-full w-full object-cover object-[78%_center] lg:object-[65%_center]"
    />
    <!-- Mobile: funde a base da foto no grafite -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-surface-dark via-surface-dark/10 to-transparent lg:hidden"
      aria-hidden="true"
    ></div>
    <!-- Desktop: escurece o lado do texto -->
    <div
      class="absolute inset-0 hidden bg-gradient-to-r from-surface-dark from-25% via-surface-dark/70 to-transparent lg:block"
      aria-hidden="true"
    ></div>
    <figcaption class="absolute bottom-4 left-5 lg:bottom-10 lg:left-auto lg:right-16 lg:text-right">
      <span class="block font-heading text-base font-semibold">Bruno Iacomini</span>
      <span class="block text-sm text-white/70">CEO · Única Promotora</span>
    </figcaption>
  </figure>

  <div class="container-app relative pb-16 pt-8 md:pb-24 lg:py-24">
    <div class="max-w-xl lg:max-w-[55%]">
      <h2 class="font-heading text-[clamp(2.25rem,1.5rem+3vw,3.75rem)] leading-[1.05] tracking-tight text-white">
        <span class="block font-bold">União,</span>
        <span class="block font-light">transformação</span>
        <span class="block font-light">e inovação.</span>
      </h2>

      <p class="mt-8 max-w-[560px] text-lg leading-relaxed md:text-xl">{homePositioning}</p>

      <h3 class="mt-10 text-sm font-semibold uppercase tracking-[0.08em] text-white/70">Valores</h3>
      <ul class="mt-5 grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {
          valores.map(({ data: valor }) => {
            const Icon = icones[valor.icone];
            return (
              <li class="flex gap-3">
                <Icon size={20} strokeWidth={1.75} className="mt-0.5 shrink-0 text-white/80" aria-hidden="true" />
                <div>
                  <p class="font-heading text-base font-semibold">{valor.nome}</p>
                  <p class="mt-0.5 text-[15px] leading-relaxed text-white/75">{valor.resumo}</p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
