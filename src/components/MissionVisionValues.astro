---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { mission, vision } from '../config/empresa';
import { icones } from '../lib/icones';
import fotoBruno from '../assets/pessoas/bruno-iacomini.png';

// Missão, visão e valores completos (página /sobre). A Home usa SobreSection, condensada.
const valores = await getCollection('valores');
---

<span id="sobre-nos" class="block scroll-mt-20" aria-hidden="true"></span>
<section id="sobre" class="relative scroll-mt-20 overflow-hidden bg-secondary text-white">
  <div class="absolute inset-0" aria-hidden="true">
    <Image
      src={fotoBruno}
      alt=""
      widths={[640, 1024, 1920]}
      sizes="100vw"
      class="h-full w-full object-cover object-[65%_center]"
    />
    <!-- escurece só o lado esquerdo (onde fica o texto) e libera a foto à direita -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-secondary from-20% via-secondary/75 via-45% to-transparent to-75%"
    ></div>
    <div class="absolute inset-0 bg-gradient-to-t from-secondary/60 via-transparent to-transparent md:hidden"></div>
  </div>

  <!-- A partir de lg o padding e a tipografia são compactados e Missão/Visão/Valores
       passam de pilha vertical para grid, para a seção caber inteira em 1920x1080. -->
  <div class="container-app relative py-16 md:py-24">
    <div class="max-w-2xl lg:max-w-none">
      <h2 class="font-heading leading-[36px] tracking-tight text-white md:leading-[90px] lg:text-[60px] lg:leading-[1.05]">
        <span class="relative inline-block pl-5 text-[40px] font-bold md:text-[96px] lg:text-[60px]">União,</span>
        <br />
        <span class="text-[40px] font-thin text-white md:text-[96px] lg:text-[60px]">transformação</span>
        <br />
        <span class="text-[40px] font-thin text-white md:text-[96px] lg:text-[60px]">e inovação.</span>
      </h2>

      <div class="mt-12 space-y-10 md:w-[60%] lg:mt-10 lg:w-[55%] lg:space-y-0">
        <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 lg:gap-y-8">
          <div>
            <h3 class="font-heading text-[32.858px] font-bold text-white lg:text-xl">Missão</h3>
            <p class="mt-3 font-brand text-[17.86px] leading-relaxed text-white/90 lg:mt-2.5 lg:text-[15px]">{mission}</p>
          </div>

          <div>
            <h3 class="font-heading text-[32.858px] font-bold text-white lg:text-xl">Visão</h3>
            <p class="mt-3 font-brand text-[17.86px] leading-relaxed text-white/90 lg:mt-2.5 lg:text-[15px]">{vision}</p>
          </div>

          <div class="lg:col-span-2">
            <h3 class="font-heading text-[32.858px] font-bold text-white lg:text-xl">Valores</h3>
            <div
              class="mt-3 space-y-3 font-brand text-[17.86px] leading-relaxed text-white/90 lg:mt-4 lg:grid lg:grid-cols-2 lg:gap-x-6 lg:gap-y-4 lg:space-y-0"
            >
              {
                valores.map(({ data: valor }, i) => {
                  const Icon = icones[valor.icone];
                  return (
                    <p class="lg:flex lg:items-start lg:gap-2.5 lg:text-[14px] lg:leading-snug">
                      <Icon
                        size={16}
                        className="hidden shrink-0 text-[var(--accent-on-dark)] lg:mt-0.5 lg:block"
                        aria-hidden="true"
                      />
                      <span>
                        <strong class="font-semibold text-white">{`${i + 1}. ${valor.nome}:`}</strong> {valor.descricao}
                      </span>
                    </p>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
