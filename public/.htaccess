# Nenhuma pasta lista os arquivos quando não tem index.
Options -Indexes

ErrorDocument 404 /404.html

# Documentos legais movidos de /assets_docs/ para /documentos/ (nomes padronizados).
# Mantidos para links já distribuídos (e-mails, contratos, buscadores).
Redirect 301 /assets_docs/compliance.pdf /documentos/compliance.pdf
Redirect 301 /assets_docs/POLITICA-DE-PRIVACIDADE-DE-DADOS.pdf /documentos/politica-de-privacidade.pdf
Redirect 301 /assets_docs/POLITICA-DE-COOKIES.pdf /documentos/politica-de-cookies.pdf
Redirect 301 /assets_docs/POLITICA-GESTAO-INCID.pdf /documentos/politica-de-gestao-de-incidentes.pdf

# /parceiros e /canais-de-atendimento foram unificadas em /bancos-parceiros.
RedirectMatch 301 ^/parceiros/?$ /bancos-parceiros
RedirectMatch 301 ^/canais-de-atendimento/?$ /bancos-parceiros

# /portfolio (portfólio para parceiros) está em rascunho até o comercial validar: leva à
# seção da Home. 302 (temporário) porque a página vai voltar; um 301 ficaria em cache nos
# navegadores. Ao publicar (portfolioPublicado = true), remova este bloco.
# mod_rewrite com [NE] para o "#" não ser codificado como %23.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^portfolio/?$ /#produtos [R=302,NE,L]
</IfModule>
