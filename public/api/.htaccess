<Files "*.csv">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Scripts auxiliares (_csv_writer, _seguranca…): só incluídos pelos endpoints.
<FilesMatch "^_.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files ".user.ini">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Pasta de dados dos formulários quando não é possível gravá-la fora de public_html
# (pasta_storage() em _seguranca.php também cria um .htaccess próprio dentro dela).
# O bloqueio de *.csv acima fica para as planilhas legadas em produção.
RedirectMatch 403 ^/api/storage/
