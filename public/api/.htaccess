<Files "*.csv">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Scripts auxiliares (_csv_writer, _seguranca…): só incluídos pelos endpoints.
<FilesMatch "^_.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files ".user.ini">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Anexos do canal de denúncias, quando não for possível gravá-los fora de public_html
# (denuncie.php também cria um .htaccess próprio dentro da pasta).
RedirectMatch 403 ^/api/denuncias-anexos/
# Contadores de envio por IP (_seguranca.php), quando não ficam fora de public_html.
RedirectMatch 403 ^/api/formularios-limites/
